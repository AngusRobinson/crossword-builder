*.pyc
*~
.*.un~
.DS_Store

# Third-party corpus: 130 MB of Guardian JSON, re-downloadable from
# the "guardian-cc" corpus. Kept locally as ground truth for the
# rule set and the grid library; not ours to version.
guardian-cc-master/

# UKACD word list, 2.6 MB. Copyright (c) 2009 J Ross Beresford,
# 3-clause BSD: redistribution IS permitted, provided the notice at the
# top of the file travels with it. Kept out of the repository for size
# and because it is obtainable upstream, not for licensing reasons.
UKACD.txt
guardian-cc-master.zip

# Generated puzzles.
out/
*.swp
# Backup bundles.
*.bundle

# Machine-local sandbox config: absolute paths, and the sandbox write-denies
# it, so git cannot update it on checkout.
.claude/settings.json

# Working word lists are the setter's own material, not project data.
# lists/ is the exception: those are demonstration themes, written for the
# repository rather than for a puzzle.
*.txt
!lists/*.txt
!crossword/grids.txt
!crossword/grids-us.txt
!crossword/grids-barred.txt
!crossword/frequency.txt
!crossword/scores.txt

# Third-party puzzle corpora: large, and not ours to redistribute.
*.zip

# Notebook checkpoints.
.ipynb_checkpoints/
