{
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": ["~/"],
      "allowRead": [
        ".",
        "~/.gitconfig",
        "~/.config/git",
        "~/opt/anaconda3"
      ]
    }
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable"
  }
}
